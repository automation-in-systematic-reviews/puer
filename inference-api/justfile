# List available recipes.
default:
    @just --list --unsorted

# ==== Setup ====

# Synchronize locked uv dependencies into the active Conda environment.
[group('setup')]
init: ensure-conda
    UV_PROJECT_ENVIRONMENT="$CONDA_PREFIX" uv sync --locked --inexact

# ==== Application ====

# Start the API server for the container runtime on port 80.
[group('application')]
run: ensure-conda
    UV_PROJECT_ENVIRONMENT="$CONDA_PREFIX" uv run --locked uvicorn app.main:app --reload --reload-dir /inference-api/app --host 0.0.0.0 --port 80

# Start the API server locally on port 12306.
[group('application')]
run-local: ensure-conda
    UV_PROJECT_ENVIRONMENT="$CONDA_PREFIX" uv run --locked uvicorn app.main:app --reload --reload-dir app --host 0.0.0.0 --port 12306

# ==== Quality ====

# Run the pytest suite.
[group('quality')]
test: ensure-conda
    UV_PROJECT_ENVIRONMENT="$CONDA_PREFIX" uv run --locked python -m pytest -vv

# Apply Ruff lint fixes, import sorting, and formatting.
[group('quality')]
fmt: ensure-conda
    UV_PROJECT_ENVIRONMENT="$CONDA_PREFIX" uv run --locked ruff check --fix app tests
    UV_PROJECT_ENVIRONMENT="$CONDA_PREFIX" uv run --locked ruff format app tests

# Check formatting, linting, and types without modifying source files.
[group('quality')]
lint: ensure-conda
    UV_PROJECT_ENVIRONMENT="$CONDA_PREFIX" uv run --locked ruff format --check app tests
    UV_PROJECT_ENVIRONMENT="$CONDA_PREFIX" uv run --locked ruff check app tests
    UV_PROJECT_ENVIRONMENT="$CONDA_PREFIX" uv run --locked ty check app tests

# Verify that the named Conda environment owns the active development tools.
[private]
ensure-conda:
    #!/usr/bin/env bash
    if [[ "${CONDA_DEFAULT_ENV:-}" != "inference-api" || -z "${CONDA_PREFIX:-}" ]]; then
        printf '%s\n' 'Activate the inference-api Conda environment first.' >&2
        exit 1
    fi

    for tool in python uv just; do
        expected="${CONDA_PREFIX}/bin/${tool}"
        actual="$(command -v "${tool}" || true)"
        if [[ "${actual}" != "${expected}" ]]; then
            if [[ -z "${actual}" ]]; then
                actual='not found'
            fi
            printf 'Expected %s at %s, but found %s.\n' \
                "${tool}" "${expected}" "${actual}" >&2
            printf '%s\n' \
                'Recreate the environment and activate it without --stack.' >&2
            exit 1
        fi
    done

    if ! "${CONDA_PREFIX}/bin/python" -c \
        'import sys; raise SystemExit(sys.version_info[:2] != (3, 12))'; then
        version="$("${CONDA_PREFIX}/bin/python" --version 2>&1)"
        printf 'The inference-api environment requires Python 3.12; found %s.\n' \
            "${version}" >&2
        printf '%s\n' 'Recreate the environment from environment.yml.' >&2
        exit 1
    fi
