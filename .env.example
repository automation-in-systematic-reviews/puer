# PUER configuration template. Copy to .env and fill in keys locally.
# Never commit the populated .env file or use these placeholders as real keys.
# Reference: docs/environment-variables.md and docs/llm-configuration.md

# Required: choose a private PUER key; clients send it as X-API-Key.
WCRF_API_KEY=replace-with-your-private-puer-key

# Required only for live OpenAI-backed endpoints; keep blank for offline work.
# This is a server-side provider credential, not the PUER client key.
OPENAI_API_KEY=

# Prompt extraction and prediction (native API environment).
# Docker Compose currently does NOT forward these two variables.
OPENAI_STUDY_SCREENING_MODEL=gpt-5.6-terra
OPENAI_STUDY_SCREENING_REASONING_EFFORT=medium

# Risk-of-bias endpoint (independent of prompt screening settings).
OPENAI_MODEL=gpt-5.2
OPENAI_REASONING_EFFORT=medium

# Docker Compose host port only; does not change the native API port.
INFERENCE_API_PORT=12306
